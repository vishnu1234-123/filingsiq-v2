# === OpenAI / LLM Providers ===
OPENAI_API_KEY=your_openai_key_here
TAVILY_API_KEY=your_tavily_key_here

# === LangChain Tracing ===
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=your_project_name_here

# === Auth / Security ===
JWT_SECRET_KEY=your_jwt_secret_here

# === App Paths (optional but recommended) ===
DB_PATH=/app/data/facts.sqlite
CHROMA_PATH=/app/data/chroma_store
CONCEPT_EMBEDDINGS_PATH=/app/data/concept_embeddings.pkl
AUDIT_LOG_PATH=/app/data/audit_log.jsonl
HITL_QUEUE_PATH=/app/data/hitl_review_queue.jsonl

